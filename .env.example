# Google Gemini API key
# Get one from Google AI Studio.
GEMINI_API_KEY=

# Current model. Change this without editing Python code.
GEMINI_MODEL=gemini-3.8-flash

# Automatic fallback if the primary model is temporarily overloaded.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Number of retries per model for transient 5xx/429 errors.
GEMINI_MAX_RETRIES=2

# true = run without Gemini using a deterministic demo document.
# false = use the real Gemini API.
DEMO_MODE=false

# Backend URL used by the Streamlit frontend.
BACKEND_URL=http://127.0.0.1:8000

# Branding
APP_NAME=LegalEase
COMPANY_NAME=LegalEase
